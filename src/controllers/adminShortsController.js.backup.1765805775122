/**
 * Google Cloud TTS API 호출
 */
function googleTTSRequest(apiKey, requestBody) {
    return new Promise((resolve, reject) => {
        const bodyStr = JSON.stringify(requestBody);
        const url = new URL(GOOGLE_TTS_API_URL);

        const options = {
            hostname: url.hostname,
            port: 443,
            path: `${url.pathname}?key=${apiKey}`,
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Content-Length': Buffer.byteLength(bodyStr, 'utf8')
            },
            timeout: 60000  // 1분 타임아웃
        };

        const req = https.request(options, (res) => {
            const chunks = [];

            res.on('data', (chunk) => {
                chunks.push(chunk);
            });

            res.on('end', () => {
                const data = Buffer.concat(chunks).toString('utf-8');

                try {
                    const jsonResponse = JSON.parse(data);
                    resolve({
                        statusCode: res.statusCode,
                        body: jsonResponse
                    });
                } catch (e) {
                    resolve({
                        statusCode: res.statusCode,
                        body: data
                    });
                }
            });
        });

        req.on('error', (error) => {
            reject(error);
        });

        req.on('timeout', () => {
            req.destroy();
            reject(new Error('Google TTS request timeout'));
        });

        req.write(bodyStr);
        req.end();
    });
}

/**
 * Google TTS 서비스 상태 확인 (서비스 계정 방식)
 */
async function checkGoogleTTSStatus() {
    try {
        // 서비스 계정 파일 존재 여부 확인
        if (!fs.existsSync(GOOGLE_CREDENTIALS_PATH)) {
            return { status: false, message: '서비스 계정 파일이 없습니다. JSON 파일을 업로드해주세요.' };
        }

        const client = initGoogleTTSClient();
        if (!client) {
            return { status: false, message: 'TTS 클라이언트 초기화 실패' };
        }

        // 간단한 테스트 요청
        const request = {
            input: { text: '테스트' },
            voice: { languageCode: 'ko-KR', name: 'ko-KR-Wavenet-A', ssmlGender: 'FEMALE' },
            audioConfig: { audioEncoding: 'MP3' }
        };

        const [response] = await client.synthesizeSpeech(request);
        return {
            status: true,
            message: 'Google TTS 연결 성공',
            audioLength: response.audioContent ? response.audioContent.length : 0
        };
    } catch (error) {
        console.error('Google TTS status check failed:', error.message);
        return { status: false, message: error.message };
    }
}

/**
 * Google TTS 음성 옵션 매핑
 */
function getGoogleVoiceConfig(voiceType = 'female', speed = 1.0) {
    // 한국어 음성 옵션
    const voiceMap = {
        'female': { languageCode: 'ko-KR', name: 'ko-KR-Wavenet-A', ssmlGender: 'FEMALE' },
        'male': { languageCode: 'ko-KR', name: 'ko-KR-Wavenet-C', ssmlGender: 'MALE' },
        'female-neural': { languageCode: 'ko-KR', name: 'ko-KR-Neural2-A', ssmlGender: 'FEMALE' },
        'male-neural': { languageCode: 'ko-KR', name: 'ko-KR-Neural2-C', ssmlGender: 'MALE' },
        // 기본값 (이전 MeloTTS 'KR' 호환)
        'KR': { languageCode: 'ko-KR', name: 'ko-KR-Wavenet-A', ssmlGender: 'FEMALE' }
    };

    const voice = voiceMap[voiceType] || voiceMap['female'];

    return {
        voice: voice,
        audioConfig: {
            audioEncoding: 'MP3',
            speakingRate: parseFloat(speed) || 1.0,
            pitch: 0,
            sampleRateHertz: 24000  // MP3 최적 샘플레이트
        }
    };
}

/**
 * 텍스트를 음성으로 변환하고 파일로 저장 (Google TTS - 서비스 계정 방식)
 * @param {string} text - 변환할 텍스트
 * @param {string} outputPath - 출력 파일 경로
 * @param {Object} options - 옵션 (voice, speed, paperId, shortsId)
 */
async function synthesizeSpeech(text, outputPath, options = {}) {
    const {
        voice = 'female',
        speed = 1.0,
        paperId = null,
        shortsId = null
    } = options;

    const client = initGoogleTTSClient();
    if (!client) {
        throw new Error('Google TTS 서비스 계정이 설정되지 않았습니다. JSON 파일을 업로드해주세요.');
    }

    const voiceConfig = getGoogleVoiceConfig(voice, speed);
    const characterCount = text.length;
    const startTime = Date.now();

    const request = {
        input: { text: text },
        voice: voiceConfig.voice,
        audioConfig: voiceConfig.audioConfig
    };

    try {
        const [response] = await client.synthesizeSpeech(request);
        const responseTime = Date.now() - startTime;

        if (!response.audioContent) {
            // 실패 로깅
            await aiService.logTTSUsage('google', characterCount, responseTime, false, 'No audio content', {
                paperId: paperId,
                shortsId: shortsId,
                voice: voiceConfig.voice.name
            });
            throw new Error('TTS synthesis failed - no audio content');
        }

        // 확장자를 .mp3로 변경 (Google TTS는 MP3 반환)
        const mp3Path = outputPath.replace('.wav', '.mp3');
        fs.writeFileSync(mp3Path, response.audioContent);

        // 성공 로깅 - API 사용량 추적
        const audioLengthSeconds = Math.ceil(response.audioContent.length / 24000); // 대략적인 오디오 길이 추정
        await aiService.logTTSUsage('google', characterCount, responseTime, true, null, {
            paperId: paperId,
            shortsId: shortsId,
            voice: voiceConfig.voice.name,
            audioLengthSeconds: audioLengthSeconds
        });

        console.log(`TTS API logged: ${characterCount} chars, ${responseTime}ms, voice: ${voiceConfig.voice.name}`);

        return {
            path: mp3Path,
            size: response.audioContent.length,
            characterCount: characterCount,
            responseTimeMs: responseTime
        };
    } catch (error) {
        const responseTime = Date.now() - startTime;
        // 에러 로깅
        await aiService.logTTSUsage('google', characterCount, responseTime, false, error.message, {
            paperId: paperId,
            shortsId: shortsId,
            voice: voiceConfig.voice.name
        });
        console.error('Google TTS synthesis error:', error.message);
        throw new Error('음성 합성 실패: ' + error.message);
    }
}

