/**
 * 쇼츠폼 생성 (전체 파이프라인)
 * 1. 논문 선택 (자동 또는 수동)
 * 2. 스크립트 자동 생성
 * 3. MeloTTS로 음성 생성
 * 4. DB에 저장
 */
exports.createShorts = async (req, res, next) => {
    try {
        let {
            paperId,
            method,
            title,
            scriptHook,
            scriptMain,
            scriptCta,
            thumbnailUrl,
            thumbnailText,
            // TTS 설정
            ttsVoice = 'KR',
            ttsSpeed = 1.0,
            generateAudio = true
        } = req.body;

        // 디렉토리 확인
        ensureDir(AUDIO_OUTPUT_DIR);

        // 1. 논문 선택 (자동 또는 수동)
        if (method === 'auto' || !paperId) {
            const candidatePaper = await queryOne(`
                SELECT p.id, p.title_ko
                FROM papers p
                WHERE DATE(p.created_at) = CURDATE()
                  AND p.processing_status = 'completed'
                  AND NOT EXISTS (
                      SELECT 1 FROM shorts s WHERE s.paper_id = p.id
                  )
                ORDER BY RAND()
                LIMIT 1
            `);

            if (!candidatePaper) {
                const recentPaper = await queryOne(`
                    SELECT p.id, p.title_ko
                    FROM papers p
                    WHERE p.created_at >= DATE_SUB(CURDATE(), INTERVAL 7 DAY)
                      AND p.processing_status = 'completed'
                      AND NOT EXISTS (
                          SELECT 1 FROM shorts s WHERE s.paper_id = p.id
                      )
                    ORDER BY RAND()
                    LIMIT 1
                `);

                if (!recentPaper) {
                    return res.status(HTTP_STATUS.BAD_REQUEST).json({
                        success: false,
                        error: {
                            code: ERROR_CODES.VALIDATION_ERROR,
                            message: '자동 선택할 수 있는 논문이 없습니다. 모든 최근 논문에 이미 쇼츠가 생성되었거나 수집된 논문이 없습니다.'
                        }
                    });
                }
                paperId = recentPaper.id;
            } else {
                paperId = candidatePaper.id;
            }
        }

        // 2. 논문 정보 조회 (요약 포함)
        const paper = await queryOne(`
            SELECT p.*, ps.tldr, ps.summary_3line, ps.business_insight
            FROM papers p
            LEFT JOIN paper_summaries ps ON p.id = ps.paper_id
            WHERE p.id = ?
        `, [paperId]);

        if (!paper) {
            return res.status(HTTP_STATUS.NOT_FOUND).json({
                success: false,
                error: { code: ERROR_CODES.NOT_FOUND, message: '논문을 찾을 수 없습니다.' }
            });
        }

        // 3. 설정 로드 및 스크립트 생성
        let script;
        let scriptSettings = {};
        try {
            const settingsRow = await queryOne(
                "SELECT setting_value FROM system_settings WHERE setting_key = 'shorts_engine_settings'"
            );
            if (settingsRow && settingsRow.setting_value) {
                scriptSettings = JSON.parse(settingsRow.setting_value);
            }
        } catch (e) {
            console.log('Could not load script settings, using defaults');
        }

        if (!scriptHook && !scriptMain && !scriptCta) {
            script = generateScript(paper, scriptSettings);
            scriptHook = script.hook;
            scriptMain = script.main;
            scriptCta = script.cta;
            thumbnailText = thumbnailText || script.thumbnailText;
        } else {
            script = {
                hook: scriptHook || '',
                main: scriptMain || '',
                cta: scriptCta || '',
                fullScript: `${scriptHook || ''} ${scriptMain || ''} ${scriptCta || ''}`
            };
        }

        // 타이틀 설정
        if (!title) {
            title = paper.title_ko || paper.title_en || '새 쇼츠';
        }

        // 4. DB에 쇼츠 레코드 생성 (먼저 ID 획득)
        const shortsId = await insert('shorts', {
            paper_id: paperId,
            title,
            script_hook: scriptHook,
            script_main: scriptMain,
            script_cta: scriptCta,
            thumbnail_url: thumbnailUrl,
            thumbnail_text: thumbnailText,
            status: SHORTS_STATUS.DRAFT
        });

        // 5. Google TTS로 음성 생성
        let audioUrl = null;
        let audioError = null;

        if (generateAudio) {
            try {
                // Google TTS API 키 확인
                const googleTtsApiKey = scriptSettings.googleTtsApiKey || scriptSettings.ttsApiKey;
                const isReady = await checkGoogleTTSStatus(googleTtsApiKey);

                if (isReady) {
                    const audioFilename = `shorts_${shortsId}_${Date.now()}.mp3`;
                    const audioPath = path.join(AUDIO_OUTPUT_DIR, audioFilename);

                    // 설정에서 Google TTS 옵션 가져오기 (요청 파라미터 > 저장된 설정 > 기본값)
                    const finalVoice = ttsVoice || scriptSettings.googleTtsVoice || 'female';
                    const finalSpeed = parseFloat(ttsSpeed || scriptSettings.googleTtsSpeed || 1.0);

                    console.log(`Google TTS settings: voice=${finalVoice}, speed=${finalSpeed}`);

                    // 음성 합성 (API 사용량 추적 포함)
                    const audioResult = await synthesizeSpeech(script.fullScript, audioPath, {
                        apiKey: googleTtsApiKey,
                        voice: finalVoice,
                        speed: finalSpeed,
                        paperId: paperId,
                        shortsId: shortsId
                    });

                    audioUrl = `/audio/shorts/${audioFilename}`;

                    // DB 업데이트
                    await query('UPDATE shorts SET audio_url = ?, status = ? WHERE id = ?', [
                        audioUrl,
                        SHORTS_STATUS.READY,
                        shortsId
                    ]);

                    console.log(`Audio generated for shorts ${shortsId}: ${audioResult.size} bytes`);
                } else {
                    audioError = 'Google TTS API 키가 설정되지 않았거나 유효하지 않습니다.';
                    console.warn('Google TTS service not ready');
                }
            } catch (ttsError) {
                audioError = ttsError.message;
                console.error('TTS generation failed:', ttsError.message);
            }
        }

        // 6. ImagineArt로 썸네일 이미지 생성 (thumbnailUrl이 없는 경우에만)
        let imageError = null;
        if (!thumbnailUrl && scriptSettings.imageApiKey && scriptSettings.imageProvider === 'imagineart') {
            try {
                console.log('Generating thumbnail image with ImagineArt...');
                const imageResult = await createThumbnailImage(paper, shortsId, {
                    imageApiKey: scriptSettings.imageApiKey,
                    imageStyle: scriptSettings.imageStyle || 'realistic'
                });

                thumbnailUrl = imageResult.url;

                // DB 업데이트
                await query('UPDATE shorts SET thumbnail_url = ? WHERE id = ?', [
                    thumbnailUrl,
                    shortsId
                ]);

                console.log(`Thumbnail image generated for shorts ${shortsId}: ${imageResult.size} bytes`);
            } catch (imageErr) {
                imageError = imageErr.message;
                console.error('Image generation failed:', imageErr.message);
            }
        }

        res.status(HTTP_STATUS.CREATED).json({
            success: true,
            message: '쇼츠폼이 생성되었습니다.',
            data: {
                shortsId,
                title,
                script: {
                    hook: scriptHook,
                    main: scriptMain,
                    cta: scriptCta
                },
                thumbnailText,
                thumbnailUrl,
                audioUrl,
                audioError,
                imageError,
                paper: {
                    id: paper.id,
                    title: paper.title_ko || paper.title_en
                },
                status: audioUrl ? SHORTS_STATUS.READY : SHORTS_STATUS.DRAFT
            }
        });
    } catch (error) {
        next(error);
    }
};

/**
 * 쇼츠폼 수정
 */
exports.updateShorts = async (req, res, next) => {
    try {
        const { id } = req.params;
        const {
            title,
            scriptHook,
            scriptMain,
            scriptCta,
            thumbnailUrl,
            thumbnailText,
            regenerateAudio = false,
            ttsVoice = 'KR',
            ttsSpeed = 1.0
        } = req.body;

        const updateData = {};
        if (title) updateData.title = title;
        if (scriptHook !== undefined) updateData.script_hook = scriptHook;
        if (scriptMain !== undefined) updateData.script_main = scriptMain;
        if (scriptCta !== undefined) updateData.script_cta = scriptCta;
        if (thumbnailUrl !== undefined) updateData.thumbnail_url = thumbnailUrl;
        if (thumbnailText !== undefined) updateData.thumbnail_text = thumbnailText;

        // 스크립트가 변경되고 regenerateAudio가 true이면 오디오 재생성
        if (regenerateAudio && (scriptHook || scriptMain || scriptCta)) {
            try {
                // 설정에서 Google TTS API 키 가져오기
                let scriptSettings = {};
                try {
                    const settingsRow = await queryOne(
                        "SELECT setting_value FROM system_settings WHERE setting_key = 'shorts_engine_settings'"
                    );
                    if (settingsRow && settingsRow.setting_value) {
                        scriptSettings = JSON.parse(settingsRow.setting_value);
                    }
                } catch (e) {
                    console.log('Could not load script settings for regeneration');
                }

                const googleTtsApiKey = scriptSettings.googleTtsApiKey || scriptSettings.ttsApiKey;
                const isReady = await checkGoogleTTSStatus(googleTtsApiKey);

                if (isReady) {
                    ensureDir(AUDIO_OUTPUT_DIR);

                    // paper_id 조회 (API 로깅용)
                    const shortsInfo = await queryOne('SELECT paper_id FROM shorts WHERE id = ?', [id]);
                    const paperId = shortsInfo?.paper_id || null;

                    const fullScript = `${scriptHook || ''} ${scriptMain || ''} ${scriptCta || ''}`.trim();
                    const audioFilename = `shorts_${id}_${Date.now()}.mp3`;
                    const audioPath = path.join(AUDIO_OUTPUT_DIR, audioFilename);

                    // 음성 합성 (API 사용량 추적 포함)
                    await synthesizeSpeech(fullScript, audioPath, {
                        apiKey: googleTtsApiKey,
                        voice: ttsVoice || scriptSettings.googleTtsVoice || 'female',
                        speed: parseFloat(ttsSpeed),
                        paperId: paperId,
                        shortsId: parseInt(id)
                    });

                    updateData.audio_url = `/audio/shorts/${audioFilename}`;
                }
            } catch (ttsError) {
                console.error('Audio regeneration failed:', ttsError.message);
            }
        }

        if (Object.keys(updateData).length > 0) {
            await query(
                `UPDATE shorts SET ${Object.keys(updateData).map(k => `${k} = ?`).join(', ')} WHERE id = ?`,
                [...Object.values(updateData), id]
            );
        }

        res.json({
            success: true,
            message: '쇼츠폼이 수정되었습니다.',
            audioRegenerated: !!updateData.audio_url
        });
    } catch (error) {
        next(error);
    }
};

