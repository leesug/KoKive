// Google Cloud TTS 클라이언트 (서비스 계정 인증)
let ttsClient = null;
const GOOGLE_CREDENTIALS_PATH = path.join(__dirname, '../../config/google-tts-credentials.json');

/**
 * Google TTS 클라이언트 초기화 (서비스 계정 방식)
 */
function initGoogleTTSClient() {
    if (ttsClient) return ttsClient;

    try {
        if (fs.existsSync(GOOGLE_CREDENTIALS_PATH)) {
            const credentials = JSON.parse(fs.readFileSync(GOOGLE_CREDENTIALS_PATH, 'utf8'));
            ttsClient = new textToSpeech.TextToSpeechClient({
                credentials: credentials
            });
            console.log('Google TTS client initialized with service account');
        } else {
            console.warn('Google TTS credentials file not found:', GOOGLE_CREDENTIALS_PATH);
        }
    } catch (error) {
        console.error('Failed to initialize Google TTS client:', error.message);
    }

    return ttsClient;
}

// Google Cloud TTS API 설정 (레거시 호환용)
const GOOGLE_TTS_API_URL = 'https://texttospeech.googleapis.com/v1/text:synthesize';

// ImagineArt API 설정
const IMAGINEART_API_URL = 'https://api.vyro.ai/v2/image/generations';

// 오디오/비디오/이미지 저장 경로
const AUDIO_OUTPUT_DIR = path.join(__dirname, '../../public/audio/shorts');
