/**
 * 쇼츠폼 성과 분석
 */
exports.getAnalytics = async (req, res, next) => {
    try {
        const { startDate, endDate, platform } = req.query;

        let platformFilter = '';
        const params = [];

        if (startDate) {
            params.push(startDate);
        } else {
            params.push(new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0]);
        }

        if (endDate) {
            params.push(endDate);
        } else {
            params.push(new Date().toISOString().split('T')[0]);
        }

        if (platform) {
            platformFilter = 'AND sp.platform = ?';
            params.push(platform);
        }

        const totalStats = await queryOne(`
            SELECT
                SUM(ss.views) as total_views,
                SUM(ss.clicks) as total_clicks,
                SUM(ss.likes) as total_likes,
                SUM(ss.comments) as total_comments,
                SUM(ss.shares) as total_shares,
                CASE WHEN SUM(ss.views) > 0
                    THEN ROUND(SUM(ss.clicks) / SUM(ss.views) * 100, 2)
                    ELSE 0 END as ctr
            FROM shorts_stats ss
            JOIN shorts_platforms sp ON ss.shorts_platform_id = sp.id
            WHERE ss.date BETWEEN ? AND ? ${platformFilter}
        `, params);

        const dailyStats = await query(`
            SELECT
                ss.date,
                SUM(ss.views) as views,
                SUM(ss.clicks) as clicks,
                SUM(ss.likes) as likes
            FROM shorts_stats ss
            JOIN shorts_platforms sp ON ss.shorts_platform_id = sp.id
            WHERE ss.date BETWEEN ? AND ? ${platformFilter}
            GROUP BY ss.date
            ORDER BY ss.date ASC
        `, params);

        const platformStats = await query(`
            SELECT
                sp.platform,
                SUM(ss.views) as views,
                SUM(ss.clicks) as clicks,
                SUM(ss.likes) as likes,
                COUNT(DISTINCT sp.shorts_id) as shorts_count
            FROM shorts_stats ss
            JOIN shorts_platforms sp ON ss.shorts_platform_id = sp.id
            WHERE ss.date BETWEEN ? AND ?
            GROUP BY sp.platform
        `, [params[0], params[1]]);

        const topShorts = await query(`
            SELECT
                s.id,
                s.title,
                p.title_ko as paper_title,
                SUM(ss.views) as total_views,
                SUM(ss.clicks) as total_clicks,
                CASE WHEN SUM(ss.views) > 0
                    THEN ROUND(SUM(ss.clicks) / SUM(ss.views) * 100, 2)
                    ELSE 0 END as ctr
            FROM shorts s
            JOIN papers p ON s.paper_id = p.id
            JOIN shorts_platforms sp ON s.id = sp.shorts_id
            JOIN shorts_stats ss ON sp.id = ss.shorts_platform_id
            WHERE ss.date BETWEEN ? AND ? ${platformFilter}
            GROUP BY s.id
            ORDER BY total_views DESC
            LIMIT 10
        `, params);

        res.json({
            success: true,
            data: {
                period: {
                    start: params[0],
                    end: params[1]
                },
                totals: {
                    views: totalStats.total_views || 0,
                    clicks: totalStats.total_clicks || 0,
                    likes: totalStats.total_likes || 0,
                    comments: totalStats.total_comments || 0,
                    shares: totalStats.total_shares || 0,
                    ctr: totalStats.ctr || 0
                },
                daily: dailyStats.map(d => ({
                    date: d.date,
                    views: d.views || 0,
                    clicks: d.clicks || 0,
                    likes: d.likes || 0
                })),
                byPlatform: platformStats.map(p => ({
                    platform: p.platform,
                    views: p.views || 0,
                    clicks: p.clicks || 0,
                    likes: p.likes || 0,
                    shortsCount: p.shorts_count
                })),
                topShorts: topShorts.map(s => ({
                    id: s.id,
                    title: s.title,
                    paperTitle: s.paper_title,
                    views: s.total_views || 0,
                    clicks: s.total_clicks || 0,
                    ctr: s.ctr
                }))
            }
        });
    } catch (error) {
        next(error);
    }
};

