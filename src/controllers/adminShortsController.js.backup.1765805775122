/**
 * 쇼츠폼 목록 조회 (관리자)
 */
exports.getShorts = async (req, res, next) => {
    try {
        const { page = 1, limit = 20, status, platform, paperId } = req.query;

        let whereClause = '1=1';
        const params = [];

        if (status) {
            whereClause += ' AND s.status = ?';
            params.push(status);
        }

        if (paperId) {
            whereClause += ' AND s.paper_id = ?';
            params.push(paperId);
        }

        if (platform) {
            whereClause += ' AND EXISTS (SELECT 1 FROM shorts_platforms sp WHERE sp.shorts_id = s.id AND sp.platform = ?)';
            params.push(platform);
        }

        const result = await paginate(`
            SELECT
                s.id,
                s.paper_id,
                s.title,
                s.status,
                s.thumbnail_url,
                s.audio_url,
                s.created_at,
                s.updated_at,
                p.title_ko as paper_title,
                p.title_en as paper_title_en,
                p.arxiv_id,
                (SELECT GROUP_CONCAT(sp.platform) FROM shorts_platforms sp WHERE sp.shorts_id = s.id) as platforms,
                (SELECT SUM(ss.views) FROM shorts_stats ss
                 JOIN shorts_platforms sp ON ss.shorts_platform_id = sp.id
                 WHERE sp.shorts_id = s.id) as total_views,
                (SELECT SUM(ss.clicks) FROM shorts_stats ss
                 JOIN shorts_platforms sp ON ss.shorts_platform_id = sp.id
                 WHERE sp.shorts_id = s.id) as total_clicks
            FROM shorts s
            JOIN papers p ON s.paper_id = p.id
            WHERE ${whereClause}
        `, params, {
            page: parseInt(page),
            limit: parseInt(limit),
            orderBy: 's.created_at DESC'
        });

        res.json({
            success: true,
            data: result.items.map(s => ({
                id: s.id,
                paperId: s.paper_id,
                title: s.title,
                status: s.status,
                thumbnailUrl: s.thumbnail_url,
                audioUrl: s.audio_url,
                paper: {
                    title: s.paper_title || s.paper_title_en || '제목 없음',
                    titleKo: s.paper_title,
                    titleEn: s.paper_title_en,
                    arxivId: s.arxiv_id
                },
                platforms: s.platforms ? s.platforms.split(',') : [],
                stats: {
                    totalViews: s.total_views || 0,
                    totalClicks: s.total_clicks || 0
                },
                createdAt: s.created_at,
                updatedAt: s.updated_at
            })),
            pagination: result.pagination
        });
    } catch (error) {
        next(error);
    }
};

/**
 * 쇼츠폼 상세 조회 (관리자)
 */
exports.getShortsById = async (req, res, next) => {
    try {
        const { id } = req.params;

        const shorts = await queryOne(`
            SELECT
                s.*,
                p.id as paper_id,
                p.arxiv_id,
                p.title_ko as paper_title,
                p.title_en as paper_title_en,
                p.primary_category,
                ps.tldr,
                ps.summary_3line,
                ps.summary_detailed,
                ps.business_insight
            FROM shorts s
            JOIN papers p ON s.paper_id = p.id
            LEFT JOIN paper_summaries ps ON p.id = ps.paper_id
            WHERE s.id = ?
        `, [id]);

        if (!shorts) {
            return res.status(HTTP_STATUS.NOT_FOUND).json({
                success: false,
                error: { code: ERROR_CODES.NOT_FOUND, message: '쇼츠폼을 찾을 수 없습니다.' }
            });
        }

        // 플랫폼 정보 조회
        const platforms = await query(`
            SELECT sp.*,
                   (SELECT SUM(views) FROM shorts_stats WHERE shorts_platform_id = sp.id) as total_views,
                   (SELECT SUM(clicks) FROM shorts_stats WHERE shorts_platform_id = sp.id) as total_clicks,
                   (SELECT SUM(likes) FROM shorts_stats WHERE shorts_platform_id = sp.id) as total_likes,
                   (SELECT SUM(comments) FROM shorts_stats WHERE shorts_platform_id = sp.id) as total_comments
            FROM shorts_platforms sp
            WHERE sp.shorts_id = ?
        `, [id]);

        res.json({
            success: true,
            data: {
                id: shorts.id,
                title: shorts.title,
                status: shorts.status,
                script: {
                    hook: shorts.script_hook,
                    main: shorts.script_main,
                    cta: shorts.script_cta
                },
                thumbnail: {
                    url: shorts.thumbnail_url,
                    text: shorts.thumbnail_text
                },
                audio: {
                    url: shorts.audio_url
                },
                paper: {
                    id: shorts.paper_id,
                    arxivId: shorts.arxiv_id,
                    titleKo: shorts.paper_title,
                    titleEn: shorts.paper_title_en,
                    category: shorts.primary_category,
                    tldr: shorts.tldr,
                    summary3line: shorts.summary_3line,
                    easyExplanation: shorts.summary_detailed,
                    businessInsight: shorts.business_insight
                },
                platforms: platforms.map(p => ({
                    id: p.id,
                    platform: p.platform,
                    videoUrl: p.video_url,
                    trackingUrl: p.tracking_url,
                    publishedAt: p.published_at,
                    stats: {
                        views: p.total_views || 0,
                        clicks: p.total_clicks || 0,
                        likes: p.total_likes || 0,
                        comments: p.total_comments || 0
                    }
                })),
                createdAt: shorts.created_at,
                updatedAt: shorts.updated_at
            }
        });
    } catch (error) {
        next(error);
    }
};

