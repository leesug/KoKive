exports.uploadTTSCredentials = async (req, res, next) => {
    try {
        const { credentials } = req.body;

        if (!credentials) {
            return res.status(400).json({
                success: false,
                error: { code: 'INVALID_INPUT', message: '서비스 계정 JSON 데이터가 필요합니다' }
            });
        }

        // JSON 유효성 검사
        let credentialsObj;
        try {
            credentialsObj = typeof credentials === 'string' ? JSON.parse(credentials) : credentials;
        } catch (e) {
            return res.status(400).json({
                success: false,
                error: { code: 'INVALID_JSON', message: '유효하지 않은 JSON 형식입니다' }
            });
        }

        // 필수 필드 확인
        if (!credentialsObj.type || !credentialsObj.project_id || !credentialsObj.private_key) {
            return res.status(400).json({
                success: false,
                error: { code: 'INVALID_CREDENTIALS', message: '유효한 서비스 계정 JSON이 아닙니다. type, project_id, private_key 필드가 필요합니다.' }
            });
        }

        // config 디렉토리 확인
        const configDir = path.dirname(GOOGLE_CREDENTIALS_PATH);
        if (!fs.existsSync(configDir)) {
            fs.mkdirSync(configDir, { recursive: true });
        }

        // 파일 저장
        fs.writeFileSync(GOOGLE_CREDENTIALS_PATH, JSON.stringify(credentialsObj, null, 2), 'utf8');

        // TTS 클라이언트 재초기화
        ttsClient = null;
        initGoogleTTSClient();

        // 연결 테스트
        const statusResult = await checkGoogleTTSStatus();

        return res.json({
            success: true,
            message: '서비스 계정이 성공적으로 업로드되었습니다',
            projectId: credentialsObj.project_id,
            connectionStatus: statusResult.status ? 'connected' : 'failed',
            connectionMessage: statusResult.message
        });

    } catch (error) {
        console.error('Upload credentials error:', error);
        return res.status(500).json({
            success: false,
            error: { code: 'UPLOAD_ERROR', message: error.message }
        });
    }
};

// TTS 테스트 음성 생성
exports.testTTS = async (req, res, next) => {
    const startTime = Date.now();
    const characterCount = req.body.text?.length || 0;

    try {
        const { text = '안녕하세요, 코키브 TTS 테스트입니다.', voice = 'female', speed = 1.0 } = req.body;
        const actualCharCount = text.length;

        // 서비스 계정 확인
        if (!fs.existsSync(GOOGLE_CREDENTIALS_PATH)) {
            return res.status(400).json({
                success: false,
                error: { code: 'NOT_CONFIGURED', message: '서비스 계정 JSON 파일이 업로드되지 않았습니다' }
            });
        }

        const client = initGoogleTTSClient();
        if (!client) {
            return res.status(500).json({
                success: false,
                error: { code: 'CLIENT_ERROR', message: 'TTS 클라이언트 초기화 실패' }
            });
        }

        const voiceConfig = getGoogleVoiceConfig(voice, speed);

        const request = {
            input: { text: text },
            voice: voiceConfig.voice,
            audioConfig: voiceConfig.audioConfig
        };

        const [response] = await client.synthesizeSpeech(request);
        const responseTime = Date.now() - startTime;

        if (!response.audioContent) {
            // 실패 로깅
            await aiService.logTTSUsage('google', actualCharCount, responseTime, false, 'No audio content', {
                voice: voiceConfig.voice.name,
                operationType: 'tts_test'
            });
            return res.status(500).json({
                success: false,
                error: { code: 'TTS_ERROR', message: '음성 생성 실패' }
            });
        }

        // 성공 로깅 - API 사용량 추적 (테스트도 기록)
        await aiService.logTTSUsage('google', actualCharCount, responseTime, true, null, {
            voice: voiceConfig.voice.name,
            operationType: 'tts_test',
            audioLengthSeconds: Math.ceil(response.audioContent.length / 24000)
        });

        // Base64로 반환
        return res.json({
            success: true,
            audioContent: response.audioContent.toString('base64'),
            contentType: 'audio/mp3'
        });

    } catch (error) {
        const responseTime = Date.now() - startTime;
        // 에러 로깅
        await aiService.logTTSUsage('google', characterCount || 0, responseTime, false, error.message, {
            operationType: 'tts_test'
        });
        console.error('TTS test error:', error);
        return res.status(500).json({
            success: false,
            error: { code: 'TTS_ERROR', message: error.message }
        });
    }
};


