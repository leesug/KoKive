/**
 * ImagineArt API를 사용하여 이미지 생성
 */
async function generateImageWithImagineArt(prompt, apiKey, options = {}) {
    const {
        style = 'realistic',
        aspectRatio = '9:16'  // 쇼츠용 세로 비율
    } = options;

    return new Promise((resolve, reject) => {
        const boundary = '----FormBoundary' + Date.now().toString(16);

        // Form data 구성
        const formParts = [];
        formParts.push(`--${boundary}\r\nContent-Disposition: form-data; name="prompt"\r\n\r\n${prompt}`);
        formParts.push(`--${boundary}\r\nContent-Disposition: form-data; name="style"\r\n\r\n${style}`);
        formParts.push(`--${boundary}\r\nContent-Disposition: form-data; name="aspect_ratio"\r\n\r\n${aspectRatio}`);
        formParts.push(`--${boundary}--`);

        const body = formParts.join('\r\n');

        const urlObj = new URL(IMAGINEART_API_URL);
        const reqOptions = {
            hostname: urlObj.hostname,
            port: 443,
            path: urlObj.pathname,
            method: 'POST',
            headers: {
                'Authorization': `Bearer ${apiKey}`,
                'Content-Type': `multipart/form-data; boundary=${boundary}`,
                'Content-Length': Buffer.byteLength(body)
            },
            timeout: 120000  // 2분 타임아웃
        };

        const req = https.request(reqOptions, (res) => {
            const chunks = [];

            res.on('data', (chunk) => {
                chunks.push(chunk);
            });

            res.on('end', () => {
                const data = Buffer.concat(chunks);

                if (res.statusCode === 200) {
                    // 성공 - 이미지 바이너리 반환
                    resolve({
                        success: true,
                        data: data,
                        contentType: res.headers['content-type'] || 'image/png'
                    });
                } else {
                    // 에러 응답
                    let errorMessage = `ImagineArt API error: ${res.statusCode}`;
                    try {
                        const errorBody = JSON.parse(data.toString());
                        errorMessage = errorBody.message || errorBody.error || errorMessage;
                    } catch (e) {
                        // 파싱 실패 시 기본 메시지 사용
                    }
                    reject(new Error(errorMessage));
                }
            });
        });

        req.on('error', (error) => {
            reject(new Error(`ImagineArt request failed: ${error.message}`));
        });

        req.on('timeout', () => {
            req.destroy();
            reject(new Error('ImagineArt request timeout'));
        });

        req.write(body);
        req.end();
    });
}

/**
 * 논문 정보로부터 이미지 프롬프트 생성
 */
function generateImagePrompt(paper, category) {
    const title = paper.title_ko || paper.title_en || 'AI Research';

    // 카테고리별 기본 프롬프트 스타일
    const categoryPrompts = {
        'cs.AI': 'futuristic AI neural network visualization, digital brain, blue and purple neon lights',
        'cs.LG': 'machine learning data visualization, abstract flowing data streams, tech aesthetic',
        'cs.CV': 'computer vision and image recognition, digital eye with data overlay',
        'cs.CL': 'natural language processing, floating text and symbols, communication',
        'cs.RO': 'advanced robotics and automation, mechanical precision',
        'default': 'cutting-edge technology, abstract digital visualization, professional'
    };

    const categoryStyle = categoryPrompts[category] || categoryPrompts['default'];

    // 쇼츠 썸네일용 프롬프트 (세로 9:16 비율에 적합)
    return `${categoryStyle}, modern tech presentation style, high quality, vertical format, cinematic lighting, 4K`;
}

/**
 * ImagineArt로 썸네일 이미지 생성 및 저장
 */
async function createThumbnailImage(paper, shortsId, settings = {}) {
    const {
        imageApiKey,
        imageStyle = 'realistic'
    } = settings;

    if (!imageApiKey) {
        throw new Error('ImagineArt API key is not configured');
    }

    ensureDir(IMAGE_OUTPUT_DIR);

    const category = paper.primary_category || 'default';
    const prompt = generateImagePrompt(paper, category);

    console.log(`Generating thumbnail image for shorts ${shortsId}, prompt: ${prompt.substring(0, 100)}...`);

    const result = await generateImageWithImagineArt(prompt, imageApiKey, {
        style: imageStyle,
        aspectRatio: '9:16'  // 쇼츠용 세로 비율
    });

    // 파일 확장자 결정
    const ext = result.contentType.includes('jpeg') ? 'jpg' : 'png';
    const filename = `shorts_${shortsId}_${Date.now()}.${ext}`;
    const filepath = path.join(IMAGE_OUTPUT_DIR, filename);

    // 이미지 저장
    fs.writeFileSync(filepath, result.data);

    console.log(`Thumbnail image saved: ${filepath} (${result.data.length} bytes)`);

    return {
        url: `/images/shorts/${filename}`,
        path: filepath,
        size: result.data.length
    };
}

